{
  "scripts": {
    "start:docker": "docker-compose up -d",
    "start:transaction-command-service": "nx serve transaction-command-service",
    "start:transaction-query-service": "nx serve transaction-query-service",
    "start:anti-fraud-service": "nx serve anti-fraud-service",
    "start:graphql-gateway": "nx serve graphql-gateway",
    "start:all": "concurrently \"npm run start:docker\" \"npm run start:transaction-command-service\" \"npm run start:transaction-query-service\" \"npm run start:anti-fraud-service\" \"npm run start:graphql-gateway\"",
    "test:anti-fraud": "nx test anti-fraud-service",
    "test:anti-fraud:unit": "nx test anti-fraud-service --testMatch='**/test/unit/**/*.spec.ts'",
    "test:anti-fraud:integration": "nx test anti-fraud-service --testMatch='**/test/integration/**/*.spec.ts'",
    "test:anti-fraud:coverage": "nx test anti-fraud-service --coverage",
    "test:transaction-command": "nx test transaction-command-service",
    "test:transaction-command:unit": "nx test transaction-command-service --testMatch='**/test/unit/**/*.spec.ts'",
    "test:transaction-command:integration": "nx test transaction-command-service --testMatch='**/test/integration/**/*.spec.ts'",
    "test:transaction-command:coverage": "nx test transaction-command-service --coverage"
  },
